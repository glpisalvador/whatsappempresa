{# Aba Fluxos: construtor visual (arrastar e soltar). Cada alteracao e gravada na hora. #}
<div class="card wae-construtor" id="wae-construtor" data-edita="{{ canedit ? 1 : 0 }}">

   <div class="card-header wae-cons-barra">
      <div class="d-flex flex-wrap align-items-center gap-2 w-100">
         <div class="d-flex align-items-center gap-2 wae-oculto" id="wae-cons-conexao-caixa">
            <i class="ti ti-device-mobile fs-2 text-secondary"></i>
            <select class="form-select form-select-sm wae-cons-seletor-conexao" id="wae-cons-conexao" title="Número de WhatsApp: cada número tem os seus fluxos"></select>
         </div>
         <i class="ti ti-git-merge fs-2 text-secondary"></i>
         <select class="form-select form-select-sm wae-cons-seletor" id="wae-cons-fluxo" title="Fluxo em edição"></select>

         {% if canedit %}
         <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-secondary" id="wae-cons-novo" title="Novo fluxo"><i class="ti ti-plus"></i><span class="d-none d-xl-inline ms-1">Novo</span></button>
            <button type="button" class="btn btn-outline-secondary dropdown-toggle" id="wae-cons-duplicar" data-bs-toggle="dropdown" title="Duplicar ou copiar para outro número"><i class="ti ti-copy"></i></button>
            <div class="dropdown-menu" id="wae-cons-copiar-menu"></div>
            <button type="button" class="btn btn-outline-danger" id="wae-cons-excluir" title="Excluir fluxo"><i class="ti ti-trash"></i></button>
         </div>
         {% endif %}

         <label class="form-check form-switch m-0 ms-1" title="Fluxo ativo no WhatsApp">
            <input class="form-check-input" type="checkbox" id="wae-cons-ativo" {{ canedit ? '' : 'disabled' }}>
            <span class="form-check-label">Ativo</span>
         </label>

         <span class="wae-cons-status text-secondary small" id="wae-cons-status"></span>

         <div class="dropdown">
            <button type="button" class="btn btn-sm btn-ghost-warning wae-oculto" id="wae-cons-avisos" data-bs-toggle="dropdown" title="Pontos de atenção">
               <i class="ti ti-alert-triangle me-1"></i><span id="wae-cons-avisos-total">0</span>
            </button>
            <div class="dropdown-menu wae-cons-lista-avisos" id="wae-cons-lista-avisos"></div>
         </div>

         <div class="ms-auto d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-success" id="wae-cons-testar" title="Conversar com o fluxo sem enviar nada pelo WhatsApp">
               <i class="ti ti-player-play me-1"></i>Testar
            </button>
            <div class="btn-group btn-group-sm">
               <button type="button" class="btn btn-outline-secondary" id="wae-cons-alternar-paleta" title="Ocultar o menu de blocos"><i class="ti ti-layout-sidebar-left-collapse"></i></button>
               <button type="button" class="btn btn-outline-secondary" id="wae-cons-alternar-props" title="Ocultar o painel de propriedades"><i class="ti ti-layout-sidebar-right-collapse"></i></button>
            </div>
            <div class="btn-group btn-group-sm">
               <button type="button" class="btn btn-outline-secondary" id="wae-cons-zoom-menos" title="Diminuir"><i class="ti ti-zoom-out"></i></button>
               <button type="button" class="btn btn-outline-secondary" id="wae-cons-zoom-normal" title="Tamanho normal"><span id="wae-cons-zoom">100%</span></button>
               <button type="button" class="btn btn-outline-secondary" id="wae-cons-zoom-mais" title="Aumentar"><i class="ti ti-zoom-in"></i></button>
               <button type="button" class="btn btn-outline-secondary" id="wae-cons-centralizar" title="Enquadrar o fluxo"><i class="ti ti-focus-centered"></i></button>
               <button type="button" class="btn btn-outline-secondary" id="wae-cons-tela-cheia" title="Tela cheia"><i class="ti ti-maximize"></i></button>
            </div>
         </div>
      </div>
   </div>

   <div class="wae-cons-corpo">
      <aside class="wae-cons-paleta" id="wae-cons-paleta">
         <div class="wae-cons-paleta-dica">
            <i class="ti ti-hand-finger me-1"></i>Arraste um bloco para a área ao lado{{ canedit ? '' : ' (somente leitura)' }}
         </div>
      </aside>

      <div class="wae-cons-tela" id="wae-cons-tela">
         <div id="wae-cons-drawflow" class="wae-df"></div>
         <div class="wae-cons-vazio wae-oculto" id="wae-cons-vazio">
            <i class="ti ti-git-merge"></i>
            <div class="fw-bold mt-2">Nenhum fluxo criado</div>
            <div class="text-secondary small">Clique em <strong>Novo</strong> para começar.</div>
         </div>
         <div class="wae-cons-legenda text-secondary small">
            <i class="ti ti-mouse me-1"></i>Arraste o fundo (ou use a roda do mouse) para navegar · Ctrl + roda para zoom · ligue a bolinha da direita de um bloco à da esquerda de outro
         </div>
      </div>

      <aside class="wae-cons-props" id="wae-cons-props"></aside>

      <aside class="wae-cons-teste wae-oculto" id="wae-cons-teste">
         <div class="wae-cons-teste-topo">
            <span class="fw-bold"><i class="ti ti-brand-whatsapp me-1 text-success"></i>Teste do fluxo</span>
            <div class="ms-auto d-flex gap-1">
               <button type="button" class="btn btn-sm btn-ghost-secondary" id="wae-cons-teste-reiniciar" title="Recomeçar"><i class="ti ti-refresh"></i></button>
               <button type="button" class="btn btn-sm btn-ghost-secondary" id="wae-cons-teste-fechar" title="Fechar"><i class="ti ti-x"></i></button>
            </div>
         </div>
         <div class="wae-cons-teste-aviso">Modo seco: nada é gravado no GLPI nem enviado pelo WhatsApp (requisições HTTP GET são feitas de verdade).</div>
         <div class="wae-cons-teste-chat" id="wae-cons-teste-chat"></div>
         <div class="input-group input-group-sm p-2">
            <input type="text" class="form-control" id="wae-cons-teste-texto" placeholder="Responda como o cliente e tecle Enter">
            <button type="button" class="btn btn-success" id="wae-cons-teste-enviar"><i class="ti ti-send"></i></button>
         </div>
      </aside>
   </div>
</div>

<script>
   $(function () {
      if (window.WAEConstrutor) {
         window.WAEConstrutor.iniciar('wae-construtor');
      }
   });
</script>
